<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 https://maven.apache.org/xsd/maven-4.0.0.xsd">
  <modelVersion>4.0.0</modelVersion>

  <parent>
    <groupId>org.springframework.boot</groupId>
    <artifactId>spring-boot-starter-parent</artifactId>
    <version>4.0.7</version>
    <relativePath/>
  </parent>

  <groupId>{{ group_id }}</groupId>
  <artifactId>{{ artifact_id }}</artifactId>
  <version>0.0.1-SNAPSHOT</version>
  <name>{{ project_name }}</name>

  <properties>
    <java.version>21</java.version>
    <mapstruct.version>1.6.3</mapstruct.version>
    <springdoc.version>2.8.5</springdoc.version>
    <testcontainers-bom.version>1.20.4</testcontainers-bom.version>
    <spotless-maven-plugin.version>2.44.3</spotless-maven-plugin.version>
    <jacoco-maven-plugin.version>0.8.12</jacoco-maven-plugin.version>
    <!-- Must always match the parent's Spring Boot version exactly, so it tracks
         ${project.parent.version} instead of a second hardcoded literal. -->
    <spring-boot-liquibase.version>${project.parent.version}</spring-boot-liquibase.version>
    <!-- Overrides spring-boot-starter-parent:4.0.7's managed 42.7.11, which is
         still vulnerable to CVE-2026-54291 (fixed in 42.7.12). -->
    <postgresql.version>42.7.12</postgresql.version>
  </properties>

  <!-- spring-boot-starter-parent:4.0.0 does not manage testcontainers.version in this environment
       (unlike spring-boot-starter-test), so this explicit BOM import is required for the
       org.testcontainers:junit-jupiter / org.testcontainers:postgresql test dependencies below to resolve. -->
{% if use_liquibase %}
  <dependencyManagement>
    <dependencies>
      <dependency>
        <groupId>org.testcontainers</groupId>
        <artifactId>testcontainers-bom</artifactId>
        <version>${testcontainers-bom.version}</version>
        <type>pom</type>
        <scope>import</scope>
      </dependency>
    </dependencies>
  </dependencyManagement>
{% endif %}

  <dependencies>
    <!-- Web & Validation: exposes REST endpoints (embedded Tomcat + Spring MVC) and
         validates incoming request payloads with Jakarta Bean Validation annotations
         (e.g. @NotNull, @Size) on DTOs. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-web</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-validation</artifactId>
    </dependency>

    <!-- Persistence & Migration: JPA/Hibernate for talking to the database from Java
         entities and repositories, Liquibase for versioned schema migrations that run
         automatically on startup, and the PostgreSQL JDBC driver so the app can connect
         to the Postgres instance started by docker-compose. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa</artifactId>
    </dependency>
{% if use_liquibase %}
    <dependency>
      <groupId>org.liquibase</groupId>
      <artifactId>liquibase-core</artifactId>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-liquibase</artifactId>
      <version>${spring-boot-liquibase.version}</version>
    </dependency>
{% endif %}
    <dependency>
      <groupId>org.postgresql</groupId>
      <artifactId>postgresql</artifactId>
      <scope>runtime</scope>
    </dependency>

    <!-- Observability: exposes operational HTTP endpoints (health, metrics, info) under
         /actuator so the app's status can be checked without custom code. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-actuator</artifactId>
    </dependency>

    <!-- Boilerplate reduction: Lombok generates getters/setters/constructors at compile
         time so entity/DTO classes stay short, and MapStruct generates the code that
         converts between entities and DTOs instead of writing it by hand. Both work via
         annotation processing, so they also need entries in the maven-compiler-plugin's
         annotationProcessorPaths below (see the <build> section) or the generated code
         won't be produced. -->
    <dependency>
      <groupId>org.projectlombok</groupId>
      <artifactId>lombok</artifactId>
      <optional>true</optional>
    </dependency>
    <dependency>
      <groupId>org.mapstruct</groupId>
      <artifactId>mapstruct</artifactId>
      <version>${mapstruct.version}</version>
    </dependency>

    <!-- API Documentation: generates an OpenAPI spec and serves an interactive
         Swagger UI (by default at /swagger-ui.html) describing this project's REST
         endpoints, so consumers can explore and try the API without extra tooling. -->
    <dependency>
      <groupId>org.springdoc</groupId>
      <artifactId>springdoc-openapi-starter-webmvc-ui</artifactId>
      <version>${springdoc.version}</version>
    </dependency>

    <!-- Testing: spring-boot-starter-test brings the general test stack (JUnit 5,
         Mockito, AssertJ); the webmvc/data-jpa test starters add slice-test support for
         testing just the web layer or just the persistence layer in isolation; the
         Testcontainers dependencies spin up a real, throwaway PostgreSQL instance in
         Docker during tests so persistence tests run against the real database engine
         instead of an in-memory fake. -->
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-webmvc-test</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.springframework.boot</groupId>
      <artifactId>spring-boot-starter-data-jpa-test</artifactId>
      <scope>test</scope>
    </dependency>
{% if use_liquibase %}
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>junit-jupiter</artifactId>
      <scope>test</scope>
    </dependency>
    <dependency>
      <groupId>org.testcontainers</groupId>
      <artifactId>postgresql</artifactId>
      <scope>test</scope>
    </dependency>
{% endif %}
  </dependencies>

  <build>
    <plugins>
      <plugin>
        <groupId>org.springframework.boot</groupId>
        <artifactId>spring-boot-maven-plugin</artifactId>
      </plugin>
      <plugin>
        <groupId>org.apache.maven.plugins</groupId>
        <artifactId>maven-compiler-plugin</artifactId>
        <configuration>
          <annotationProcessorPaths>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok</artifactId>
            </path>
            <path>
              <groupId>org.projectlombok</groupId>
              <artifactId>lombok-mapstruct-binding</artifactId>
              <version>0.2.0</version>
            </path>
            <path>
              <groupId>org.mapstruct</groupId>
              <artifactId>mapstruct-processor</artifactId>
              <version>${mapstruct.version}</version>
            </path>
          </annotationProcessorPaths>
        </configuration>
      </plugin>
      <!-- Code style: enforces Google Java Format on every .java file. `mvn spotless:check`
           (bound to the `verify` phase below) fails the build on non-conformant formatting;
           run `mvn spotless:apply` locally to auto-fix. Deliberately not bound to
           `compile`/`test-compile` so it never blocks Forge's own scaffolding validation,
           only the full `mvn verify`/`mvn install` lifecycle a developer runs before
           committing. -->
      <plugin>
        <groupId>com.diffplug.spotless</groupId>
        <artifactId>spotless-maven-plugin</artifactId>
        <version>${spotless-maven-plugin.version}</version>
        <configuration>
          <java>
            <googleJavaFormat/>
          </java>
        </configuration>
        <executions>
          <execution>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
          </execution>
        </executions>
      </plugin>
      <!-- Code coverage gate: instruments tests (prepare-agent), writes an HTML/XML
           report to target/site/jacoco after `test`, then fails `verify` if overall
           line coverage drops below 90%. Bound to `verify`, not `test-compile`, for
           the same reason Spotless is above — never blocks Forge's own scaffolding
           validation (`mvn test-compile`), only a full `mvn verify`/CI run. -->
      <plugin>
        <groupId>org.jacoco</groupId>
        <artifactId>jacoco-maven-plugin</artifactId>
        <version>${jacoco-maven-plugin.version}</version>
        <configuration>
          <!-- Excludes pure framework-bootstrap/bean-wiring code with no business logic to
               test: the application entry point's main() method, and @Configuration classes
               that only construct/register framework beans (JpaAuditingConfig, OpenApiConfig).
               CorrelationIdFilter stays in scope — it has real request-handling logic and is
               already tested. -->
          <excludes>
            <exclude>**/*Application.class</exclude>
            <exclude>**/common/config/JpaAuditingConfig.class</exclude>
            <exclude>**/common/config/OpenApiConfig.class</exclude>
          </excludes>
        </configuration>
        <executions>
          <execution>
            <id>prepare-agent</id>
            <goals>
              <goal>prepare-agent</goal>
            </goals>
          </execution>
          <execution>
            <id>report</id>
            <phase>test</phase>
            <goals>
              <goal>report</goal>
            </goals>
          </execution>
          <execution>
            <id>check</id>
            <phase>verify</phase>
            <goals>
              <goal>check</goal>
            </goals>
            <configuration>
              <rules>
                <rule>
                  <element>BUNDLE</element>
                  <limits>
                    <limit>
                      <counter>LINE</counter>
                      <value>COVEREDRATIO</value>
                      <minimum>0.90</minimum>
                    </limit>
                  </limits>
                </rule>
              </rules>
            </configuration>
          </execution>
        </executions>
      </plugin>
    </plugins>
  </build>
</project>
